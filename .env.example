# MongoDB Atlas — get these from https://cloud.mongodb.com
# Database > Connect > Drivers > Node.js
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<options>
MONGODB_DB=study_abroad

# Cloudinary — get these from https://console.cloudinary.com/dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Auth.js (Phase 1) — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Minimum 32 characters. Server-only, never prefix with NEXT_PUBLIC_.
AUTH_SECRET=
# AUTH_URL is only needed if the app runs behind a proxy/custom domain and
# Auth.js cannot infer the canonical URL (default: auto-detected).
